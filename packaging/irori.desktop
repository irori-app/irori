[Desktop Entry]
Type=Application
Name=Irori
GenericName=Game Launcher
Comment=Play your Epic, GOG, Amazon and ZOOM games on Linux
Exec=irori %u
Icon=irori
Terminal=false
Categories=Game;
Keywords=epic;gog;amazon;zoom;launcher;wine;proton;heroic;
MimeType=x-scheme-handler/irori;application/x-msdownload;application/x-ms-dos-executable;application/vnd.microsoft.portable-executable;application/x-msi;application/x-bat;text/x-ms-regedit;
StartupWMClass=irori
Actions=BigPicture;

[Desktop Action BigPicture]
Name=Big Picture
Exec=irori --big-picture
