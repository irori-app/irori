---
import type { CollectionEntry } from 'astro:content'
import Article from '../layouts/Article.astro'
import { dictionary, type Locale } from '../i18n/config'
import { relatedOf, slugOf } from '../lib/pages'

interface Props {
  locale: Locale
  entry: CollectionEntry<'compare'>
}
const { locale, entry } = Astro.props
const t = dictionary(locale)
const data = entry.data
const related = await relatedOf('compare', data.related, locale)
const crumbs = [
  { name: t.nav.compare, path: '/compare/' },
  { name: `Irori vs ${data.rival}`, path: `/compare/${slugOf(entry.id)}/` },
]
---

<Article locale={locale} section="compare" entry={entry} related={related} crumbs={crumbs}>
  <p slot="tag" class="tag">{t.nav.compare}</p>
  <div slot="hero" class="mt-12" data-reveal>
    <h2 class="sr-only">{t.compare.tableTitle}</h2>
    <div class="overflow-x-auto rounded-2xl border border-grain" tabindex="0" role="region" aria-label={t.compare.tableTitle}>
      <table class="vs w-full min-w-[34rem] border-collapse text-left">
        <thead>
          <tr>
            <th scope="col">{t.compare.feature}</th>
            <th scope="col" class="is-irori">Irori</th>
            <th scope="col">{data.rival}</th>
          </tr>
        </thead>
        <tbody>
          {
            data.rows.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                <td class="is-irori">{row.irori}</td>
                <td>{row.rival}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 font-mono text-xs text-smoke">
      {t.compare.checked} <a class="link" href="https://github.com/irori-app/irori/issues">{t.compare.report}</a>
    </p>
  </div>
</Article>

<style>
  .vs th,
  .vs td {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--grain);
    vertical-align: top;
    font-size: 0.97rem;
  }
  .vs tbody tr:last-child > * {
    border-bottom: none;
  }
  .vs thead th {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--paper);
    background: var(--soot);
  }
  .vs tbody th {
    font-weight: 500;
    color: var(--paper);
    width: 30%;
  }
  .vs td {
    color: var(--smoke);
  }
  .vs .is-irori {
    color: var(--paper);
    background: color-mix(in oklab, var(--flame) 8%, transparent);
  }
  .vs thead .is-irori {
    color: var(--flame-text);
    box-shadow: inset 0 3px 0 var(--flame);
  }
</style>
