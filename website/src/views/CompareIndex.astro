---
import { ArrowRight } from '@lucide/vue'
import CompareTable from '../components/CompareTable.astro'
import PageHeader from '../components/PageHeader.astro'
import Base from '../layouts/Base.astro'
import { REPO } from '../data/site'
import { dictionary, localePath, type Locale } from '../i18n/config'
import { entries, slugOf } from '../lib/pages'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = dictionary(locale)
const list = await entries('compare', locale)
const crumbs = [{ name: t.nav.compare, path: '/compare/' }]
---

<Base locale={locale} title={t.compare.title} description={t.compare.description} path="/compare/" crumbs={crumbs}>
  <PageHeader locale={locale} crumbs={crumbs} title={t.compare.h1} lede={t.compare.lede} />
  <section class="gutter mx-auto max-w-7xl">
    <ul class="grid gap-4 md:grid-cols-3">
      {
        list.map((entry, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <a href={localePath(locale, `/compare/${slugOf(entry.id)}/`)} class="group flex h-full flex-col gap-3 rounded-2xl border border-grain bg-soot/60 p-6 transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-wood" data-glow>
              <span class="font-display text-2xl font-bold text-paper">
                Irori <span class="text-smoke">vs</span> {entry.data.rival}
              </span>
              <span class="text-[0.97rem] leading-relaxed text-smoke">{entry.data.summary}</span>
              <ArrowRight class="mt-auto size-5 text-smoke transition-transform group-hover:translate-x-1 group-hover:text-flame-text" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
    <h2 class="section-title mt-20 mb-6 !text-2xl">{t.compare.tableTitle}</h2>
    <div data-reveal><CompareTable locale={locale} caption={t.compare.tableTitle} /></div>
    <p class="mt-3 font-mono text-xs text-smoke">
      {t.compare.checked} <a class="link" href={`${REPO}/issues`}>{t.compare.report}</a>
    </p>
  </section>
</Base>
