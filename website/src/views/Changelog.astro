---
import { ArrowUpRight } from '@lucide/vue'
import PageHeader from '../components/PageHeader.astro'
import Base from '../layouts/Base.astro'
import { REPO } from '../data/site'
import { dictionary, type Locale } from '../i18n/config'
import { getReleases } from '../lib/github'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = dictionary(locale)
const releases = await getReleases()
const crumbs = [{ name: t.nav.changelog, path: '/changelog/' }]
const day = (iso: string) => new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
---

<Base locale={locale} title={t.changelog.title} description={t.changelog.description} path="/changelog/" crumbs={crumbs}>
  <PageHeader locale={locale} crumbs={crumbs} title={t.changelog.h1} lede={t.changelog.lede} />
  <div class="gutter mx-auto max-w-7xl">
    {
      releases === null || releases.length === 0 ? (
        <p class="text-smoke">
          {t.changelog.unavailable} <a class="link" href={`${REPO}/releases`}>{t.changelog.unavailableLink}</a>
        </p>
      ) : (
        <ol class="timeline flex flex-col">
          {releases.map((release, index) => (
            <li class="release grid gap-4 pb-16 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10" id={release.tag}>
              <div class="flex flex-col gap-1 md:sticky md:top-28 md:self-start">
                <a href={`#${release.tag}`} class="font-mono text-2xl font-medium text-paper">
                  {release.version}
                </a>
                {release.date && <time datetime={release.date} class="font-mono text-sm text-smoke">{day(release.date)}</time>}
                {index === 0 && <span class="mt-1 self-start rounded-full bg-flame px-2.5 py-0.5 font-mono text-xs font-medium text-flame-ink">{t.changelog.latest}</span>}
              </div>
              <article class="min-w-0 rounded-2xl border border-grain bg-soot/50 p-6 sm:p-8" data-reveal={index > 0 ? '' : undefined}>
                <h2 class="font-display text-2xl font-bold text-paper">{release.name}</h2>
                <div class="prose mt-4 max-w-none" set:html={release.html} />
                <a href={release.url} class="link mt-6 inline-flex items-center gap-1 font-mono text-sm">
                  {t.changelog.onGithub} <ArrowUpRight class="size-4" aria-hidden="true" />
                </a>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>

<style>
  .timeline {
    position: relative;
  }
  @media (min-width: 768px) {
    .timeline::before {
      content: '';
      position: absolute;
      left: 11.25rem;
      top: 0.5rem;
      bottom: 4rem;
      width: 1px;
      background: linear-gradient(180deg, var(--flame), var(--grain) 30%, transparent);
    }
  }
  .release :global(.prose h2) {
    font-size: 1.3rem;
    margin-top: 2rem;
  }
</style>
