---
import type { GetStaticPaths } from 'astro'
import Guide from '../../views/Guide.astro'
import { entries, slugOf } from '../../lib/pages'

export const getStaticPaths = (async () =>
  (await entries('guides', 'en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }))) satisfies GetStaticPaths

const { entry } = Astro.props
---

<Guide locale="en" entry={entry} />
