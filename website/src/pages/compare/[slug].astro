---
import type { GetStaticPaths } from 'astro'
import Comparison from '../../views/Comparison.astro'
import { entries, slugOf } from '../../lib/pages'

export const getStaticPaths = (async () =>
  (await entries('compare', 'en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }))) satisfies GetStaticPaths

const { entry } = Astro.props
---

<Comparison locale="en" entry={entry} />
