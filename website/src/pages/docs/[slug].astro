---
import type { GetStaticPaths } from 'astro'
import Doc from '../../views/Doc.astro'
import { entries, slugOf } from '../../lib/pages'

export const getStaticPaths = (async () =>
  (await entries('docs', 'en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }))) satisfies GetStaticPaths

const { entry } = Astro.props
---

<Doc locale="en" entry={entry} />
