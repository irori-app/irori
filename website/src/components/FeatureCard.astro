---
/** A card that links to one feature page. */
import { ArrowRight } from '@lucide/vue'
import { icon } from '../lib/icons'

interface Props {
  href: string
  tag: string
  title: string
  summary: string
  iconName: string
  delay?: number
}
const { href, tag, title, summary, iconName, delay = 0 } = Astro.props
const Icon = icon(iconName)
---

<a
  href={href}
  class="feature-card group flex h-full min-w-0 flex-col gap-4 rounded-2xl border border-grain bg-soot/60 p-6 transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-wood"
  data-glow
  data-reveal
  style={`--reveal-delay:${delay}`}
>
  <span class="grid size-11 place-items-center rounded-xl border border-grain bg-ash text-flame-text transition-colors group-hover:border-flame">
    <Icon class="size-5" aria-hidden="true" />
  </span>
  <span class="flex min-w-0 flex-col gap-1.5">
    <span class="tag">{tag}</span>
    <span class="font-display text-xl font-bold leading-tight text-paper">{title}</span>
    <span class="text-[0.97rem] leading-relaxed text-smoke">{summary}</span>
  </span>
  <ArrowRight class="mt-auto size-5 text-smoke transition-transform duration-300 group-hover:translate-x-1 group-hover:text-flame-text" aria-hidden="true" />
</a>
