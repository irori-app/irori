# Serves the built site. Coolify's proxy terminates TLS in front of it.
:80 {
	root * /srv
	encode zstd gzip
	# Pages are folders with an index.html; file_server redirects /docs to /docs/.
	file_server

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /screenshots/* /brand/* /covers/* /og/*
	header @media Cache-Control "public, max-age=86400"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}
